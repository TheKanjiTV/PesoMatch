{
  "name": "pesomatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint && vite build",
    "lint": "oxlint --threads=1 -A all -D no-undef -D react/jsx-no-undef -c .oxlintrc.json src",
    "preview": "vite preview",
    "format": "oxfmt",
    "test": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "android:build": "node scripts/run-powershell.mjs android/build-local.ps1",
    "mobile:preview": "node scripts/run-powershell.mjs scripts/start-mobile-preview.ps1",
    "local": "node scripts/run-powershell.mjs scripts/start-local.ps1"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "oxlint": "1.94.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.16"
  }
}
