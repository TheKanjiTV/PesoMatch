Options -Indexes -MultiViews
<Files "index.php">
    SetHandler application/x-lsphp84
</Files>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(?:backend|vendor|storage|node_modules|composer\.(?:json|lock)|package\.json)(?:/|$) - [F,L,NC]
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]
    RewriteRule ^(?:api|sanctum)(?:/|$) index.php [L,QSA]
    RewriteRule ^up/?$ index.php [L,QSA]
    RewriteRule ^index\.php$ - [L]
    RewriteRule \.(?:php[0-9]*|phtml|phar|sql|zip|bak|log|env)$ - [R=404,L,NC]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    # Missing assets must be 404, never the SPA HTML fallback.
    RewriteRule ^(?:assets|fonts|icons|images|downloads)(?:/|$) - [R=404,L]
    RewriteRule ^ index.html [L]
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
DirectoryIndex index.html index.php
